{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "NightWatch": {
    "EnvironmentName": "Development",
    "Storage": {
      "Provider": "postgresql",
      "ConnectionString": ""
    },
    "Redis": {
      "ConnectionString": "",
      "Required": false
    },
    "Scoring": {
      "Enabled": false,
      "ExperimentalMlEnabled": false,
      "ModelVersion": "none"
    },
    "IpDatasets": {
      "Mode": "offline_bundle",
      "BundlePath": "",
      "AllowOutboundLookup": false
    },
    "KeyRotation": {
      "MaxKeyAgeDays": 90
    },
    "Privacy": {
      "DefaultRetentionDays": 90,
      "RequirePurposeOnIngest": true
    },
    "SdkVersions": {
      "MinBrowserSdk": "0.1.0-rc.1",
      "LegacySourceManifestRevision": "default-v1",
      "IdentityAlgorithmVersion": "night-watch-identity-v4"
    },
    "FeatureFlags": {
      "SmartSignals": "Disabled",
      "Webhooks": "Disabled",
      "ExperimentalMl": "Disabled",
      "IdentifyApi": "Enabled"
    },
    "TenantOverrides": {},
    "ForbidVendorHosts": true,
    "ApplePay": "excluded"
  }
}
