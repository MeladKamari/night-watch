# Copy to server/.env for Iran / private-cloud labs
POSTGRES_PASSWORD=change-me-strong
ASPNETCORE_ENVIRONMENT=Production
NightWatch__EnvironmentName=Production
NightWatch__IpDatasets__AllowOutboundLookup=false
NightWatch__FeatureFlags__ExperimentalMl=Disabled
NightWatch__Redis__Required=false
NightWatch__MigrateOnStartup=true
# Optional: pin console origin CORS separately in appsettings
