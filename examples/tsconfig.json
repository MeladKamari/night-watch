{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@thenightwatch/browser-sdk": ["../packages/browser-sdk/dist/index.d.ts"],
      "@thenightwatch/core": ["../packages/core/dist/index.d.ts"]
    },
    "baseUrl": "."
  },
  "include": ["./**/*.ts"]
}
