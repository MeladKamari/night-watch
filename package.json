{
  "name": "night-watch",
  "private": true,
  "version": "1.0.0",
  "description": "Night Watch — self-hosted browser fingerprinting SDK (41-source default profile)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false && pnpm --filter @night-watch/playground run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b --pretty false && pnpm run bundle",
    "bundle": "pnpm --filter @night-watch/core run bundle && pnpm --filter @night-watch/browser-sdk run bundle",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:console": "playwright test -c playwright.console.config.ts",
    "test:e2e:console:live": "playwright test -c playwright.console.live.config.ts",
    "test:e2e:matrix": "playwright test --project=chromium --project=firefox --project=webkit --project=chromium-incognito tests/e2e/browser-matrix.spec.ts",
    "test:registry": "node --test tests/unit/baseline-registry.test.mjs",
    "playground": "pnpm --filter @night-watch/playground dev",
    "pretest": "pnpm build",
    "pretest:e2e": "pnpm build",
    "ci:guard": "node scripts/ci/guard-excluded-payment-source.mjs",
    "ci:sbom": "node scripts/ci/generate-sbom.mjs --out reference/sbom.cdx.json",
    "ci:bundle-smoke": "node scripts/ci/bundle-import-smoke.mjs",
    "ci:checksums": "node scripts/ci/checksum-artifacts.mjs",
    "ci:lockfile": "node scripts/ci/lockfile-integrity.mjs",
    "ci:vendor-audit": "node scripts/ci/vendor-bundle-audit.mjs",
    "ci:release-gate": "node scripts/ci/release-gate.mjs",
    "audit:prod": "pnpm audit --prod",
    "examples:typecheck": "tsc -p examples/tsconfig.json --pretty false",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "release:publish:execute": "node scripts/release/publish.mjs --execute"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@fingerprintjs/fingerprintjs": "5.3.0",
    "@night-watch/browser-sdk": "workspace:*",
    "@night-watch/core": "workspace:*",
    "@night-watch/vanilla": "workspace:*",
    "@night-watch/react": "workspace:*",
    "@night-watch/preact": "workspace:*",
    "@night-watch/vue": "workspace:*",
    "@night-watch/angular": "workspace:*",
    "@night-watch/blazor": "workspace:*",
    "@night-watch/contracts": "workspace:*",
    "@night-watch/browser-adapter": "workspace:*",
    "@night-watch/server-sdk": "workspace:*",
    "@night-watch/dashboard-client": "workspace:*",
    "@night-watch/web-agent": "workspace:*",
    "@types/react": "^19.0.10",
    "preact": "^10.26.4",
    "react": "^19.0.0",
    "vue": "^3.5.13",
    "@angular/core": "^19.2.0",
    "rxjs": "^7.8.2",
    "@playwright/test": "^1.51.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "rollup": "^4.67.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
