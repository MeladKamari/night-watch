{
  "name": "@thenightwatch/vue",
  "version": "1.0.1",
  "description": "Night Watch Vue composables for visitor identification",
  "license": "MIT",
  "keywords": [
    "fingerprint",
    "vue",
    "composable",
    "visitor-id"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE",
    "logo.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@thenightwatch/vanilla": "workspace:*",
    "@thenightwatch/browser-sdk": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeladKamari/night-watch.git",
    "directory": "packages/vue"
  }
}
