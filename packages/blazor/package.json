{
  "name": "@night-watch/blazor",
  "version": "1.0.0",
  "description": "Night Watch Blazor / WebAssembly JS interop helpers",
  "license": "MIT",
  "keywords": [
    "fingerprint",
    "blazor",
    "webassembly",
    "dotnet",
    "visitor-id"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interop": {
      "types": "./dist/interop.d.ts",
      "import": "./dist/interop.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "csharp",
    "NOTICE",
    "logo.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@night-watch/vanilla": "workspace:*",
    "@night-watch/browser-sdk": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
