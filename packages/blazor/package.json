{
  "name": "@thenightwatch/blazor",
  "version": "1.0.1",
  "description": "INTERNAL JS helpers for NightWatch.Blazor — publish the C# package to NuGet, not this npm package.",
  "license": "MIT",
  "keywords": [
    "fingerprint",
    "blazor",
    "webassembly",
    "dotnet",
    "visitor-id"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interop": {
      "types": "./dist/interop.d.ts",
      "import": "./dist/interop.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "csharp",
    "NOTICE",
    "logo.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@thenightwatch/vanilla": "workspace:*",
    "@thenightwatch/browser-sdk": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeladKamari/night-watch.git",
    "directory": "packages/blazor"
  },
  "private": true
}
