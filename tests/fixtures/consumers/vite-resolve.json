{
  "$schema": "https://json.schemastore.org/package.json",
  "description": "Vite/webpack-style resolve map fixture (documentation + test assertion). Consumes first-party package exports only — no CDN.",
  "resolutions": {
    "@thenightwatch/browser-sdk": {
      "types": "packages/browser-sdk/dist/index.d.ts",
      "import": "packages/browser-sdk/dist/index.js",
      "bundledImport": "packages/browser-sdk/dist/fp.esm.js",
      "require": "packages/browser-sdk/dist/fp.cjs",
      "browserScript": "packages/browser-sdk/dist/fp.min.js",
      "browserUmd": "packages/browser-sdk/dist/fp.umd.min.js"
    },
    "@thenightwatch/core": {
      "types": "packages/core/dist/index.d.ts",
      "import": "packages/core/dist/index.js",
      "require": "packages/core/dist/core.cjs"
    }
  },
  "sideEffects": false,
  "offline": true,
  "cdn": null
}
